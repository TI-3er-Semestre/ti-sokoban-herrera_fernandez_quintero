<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>

<!--
    VISTA — main-menu.fxml

    La imagen de fondo (main_menu_bg.png) ya tiene los botones dibujados.
    Encima ponemos botones completamente transparentes posicionados
    exactamente sobre cada botón de la imagen.

    Ventana: 840 x 690
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.icesi.sokoban.controller.MainMenuController"
           prefWidth="840" prefHeight="690">

    <!-- Imagen de fondo con los botones dibujados -->
    <ImageView fitWidth="840" fitHeight="690" preserveRatio="false">
        <image>
            <Image url="@../sprites/pages/main_menu_bg.png"/>
        </image>
    </ImageView>

    <!-- Botones invisibles sobre la imagen -->
    <Pane prefWidth="840" prefHeight="690">

        <!-- Jugar -->
        <Button fx:id="jugarButton"
                onAction="#onJugarClicked"
                layoutX="300" layoutY="245"
                prefWidth="235" prefHeight="48"
                opacity="0.0"
                style="-fx-cursor: hand;"/>

        <!-- Registro de Jugador -->
        <Button onAction="#onRegistroClicked"
                layoutX="300" layoutY="300"
                prefWidth="235" prefHeight="48"
                opacity="0.0"
                style="-fx-cursor: hand;"/>

        <!-- Ranking -->
        <Button onAction="#onRankingClicked"
                layoutX="300" layoutY="378"
                prefWidth="235" prefHeight="45"
                opacity="0.0"
                style="-fx-cursor: hand;"/>

        <!-- Manual -->
        <Button onAction="#onManualClicked"
                layoutX="300" layoutY="445"
                prefWidth="235" prefHeight="45"
                opacity="0.0"
                style="-fx-cursor: hand;"/>

        <!-- Salir -->
        <Button onAction="#onSalirClicked"
                layoutX="300" layoutY="500"
                prefWidth="235" prefHeight="45"
                opacity="0.0"
                style="-fx-cursor: hand;"/>

    </Pane>

</StackPane>
