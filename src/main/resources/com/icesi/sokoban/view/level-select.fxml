<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<!--
    VISTA — level-select.fxml
    Pantalla de selección de nivel antes de iniciar el juego.

    Muestra 4 opciones:
      - Nivel 1: First Steps    (BASIC)
      - Nivel 2: The Labyrinth  (ADVANCED)
      - Nivel 3: The Algorithm  (EXPERT)
      - Aleatorio               (nivel al azar)

    LevelSelectController maneja la selección y navega a game.fxml
    pasándole el número de nivel elegido.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.icesi.sokoban.controller.LevelSelectController"
      alignment="CENTER"
      spacing="24"
      style="-fx-background-color: #0f0e17; -fx-padding: 50;">

    <!-- Título -->
    <Label text="Selecciona un Nivel"
           style="-fx-text-fill: #fffffe;
                  -fx-font-size: 34px;
                  -fx-font-weight: bold;"/>

    <Label text="Elige tu desafío"
           style="-fx-text-fill: #a7a9be; -fx-font-size: 14px;"/>

    <!-- Tarjetas de niveles -->
    <VBox spacing="12" alignment="CENTER">

        <!-- Nivel 1 -->
        <Button onAction="#onNivel1Clicked"
                prefWidth="340"
                style="-fx-background-color: #1a2e1a;
                       -fx-border-color: #3da94f;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-padding: 16;">
            <graphic>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="1"
                           style="-fx-text-fill: #3da94f;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-min-width: 36;"/>
                    <VBox spacing="2">
                        <Label text="First Steps"
                               style="-fx-text-fill: #fffffe;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>
                        <Label text="⭐ BÁSICO  ·  8×10  ·  1 caja"
                               style="-fx-text-fill: #a7a9be; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <!-- Nivel 2 -->
        <Button onAction="#onNivel2Clicked"
                prefWidth="340"
                style="-fx-background-color: #1a1a2e;
                       -fx-border-color: #3da9fc;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-padding: 16;">
            <graphic>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="2"
                           style="-fx-text-fill: #3da9fc;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-min-width: 36;"/>
                    <VBox spacing="2">
                        <Label text="The Labyrinth"
                               style="-fx-text-fill: #fffffe;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>
                        <Label text="⭐⭐ AVANZADO  ·  10×12  ·  3 cajas"
                               style="-fx-text-fill: #a7a9be; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <!-- Nivel 3 -->
        <Button onAction="#onNivel3Clicked"
                prefWidth="340"
                style="-fx-background-color: #2e1a1a;
                       -fx-border-color: #ef4565;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-padding: 16;">
            <graphic>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="3"
                           style="-fx-text-fill: #ef4565;
                                  -fx-font-size: 28px;
                                  -fx-font-weight: bold;
                                  -fx-min-width: 36;"/>
                    <VBox spacing="2">
                        <Label text="The Algorithm"
                               style="-fx-text-fill: #fffffe;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>
                        <Label text="⭐⭐⭐ EXPERTO  ·  12×14  ·  5 cajas"
                               style="-fx-text-fill: #a7a9be; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <!-- Aleatorio -->
        <Button onAction="#onAleatorioClicked"
                prefWidth="340"
                style="-fx-background-color: #2e2a1a;
                       -fx-border-color: #ff8906;
                       -fx-border-radius: 8;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-padding: 16;">
            <graphic>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <Label text="🎲"
                           style="-fx-font-size: 28px; -fx-min-width: 36;"/>
                    <VBox spacing="2">
                        <Label text="Nivel Aleatorio"
                               style="-fx-text-fill: #fffffe;
                                      -fx-font-size: 16px;
                                      -fx-font-weight: bold;"/>
                        <Label text="Sorpréndeme"
                               style="-fx-text-fill: #a7a9be; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

    </VBox>

    <!-- Botón volver -->
    <Button fx:id="volverButton"
            text="← Volver al Menú"
            onAction="#onVolverClicked"
            style="-fx-background-color: transparent;
                   -fx-text-fill: #a7a9be;
                   -fx-font-size: 13px;
                   -fx-cursor: hand;
                   -fx-border-color: transparent;"/>

</VBox>
