<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<!--
    VISTA — player-registration.fxml  (RF1: Registrar jugador — paso 1)

    Estructura:
      - Fondo: register_bg.jpg a pantalla completa
      - Botones invisibles superpuestos sobre los campos de la imagen
      - Botón "Jugar tu avatar" → onSiguienteClicked() en PlayerRegistrationController

    Los campos TextField y el ChoiceBox están posicionados sobre
    los campos visuales del fondo para dar la ilusión de integración.
    El Label statusLabel aparece debajo del formulario para mostrar errores.
-->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.icesi.sokoban.controller.PlayerRegistrationController"
           prefWidth="840" prefHeight="840">

    <!-- Fondo -->
    <ImageView fitWidth="840" fitHeight="840" preserveRatio="false">
        <image>
            <Image url="@../sprites/pages/register_bg.jpg"/>
        </image>
    </ImageView>

    <!-- Capa de controles superpuesta -->
    <Pane prefWidth="840" prefHeight="840">

        <!-- Campo: Nombre completo -->
        <TextField fx:id="nameField"
                   promptText="                             "
                   layoutX="260" layoutY="274"
                   prefWidth="555" prefHeight="60"
                   style="-fx-background-color: transparent;
                          -fx-text-fill: #fffffe;
                          -fx-prompt-text-fill: #888aaa;
                          -fx-font-size: 15px;
                          -fx-border-color: transparent;
                          -fx-padding: 0 8 0 8;"/>

        <!-- Campo: Correo electrónico -->
        <TextField fx:id="emailField"
                   promptText="                             "
                   layoutX="265" layoutY="390"
                   prefWidth="555" prefHeight="44"
                   style="-fx-background-color: transparent;
                          -fx-text-fill: #fffffe;
                          -fx-prompt-text-fill: #888aaa;
                          -fx-font-size: 15px;
                          -fx-border-color: transparent;
                          -fx-padding: 0 8 0 8;"/>

        <!-- Campo: Username -->
        <TextField fx:id="usernameField"
                   promptText="                             "
                   layoutX="265" layoutY="500"
                   prefWidth="555" prefHeight="44"
                   style="-fx-background-color: transparent;
                          -fx-text-fill: #fffffe;
                          -fx-prompt-text-fill: #888aaa;
                          -fx-font-size: 15px;
                          -fx-border-color: transparent;
                          -fx-padding: 0 8 0 8;"/>

        <!-- Campo: Nivel de experiencia -->
        <ChoiceBox fx:id="levelChoice"
                   layoutX="265" layoutY="620"
                   prefWidth="555" prefHeight="44"
                   style="-fx-background-color: transparent;
                          -fx-mark-color: #a7a9be;
                          -fx-border-color: transparent;"/>

        <!-- Mensaje de error -->
        <Label fx:id="statusLabel"
               text=""
               layoutX="270" layoutY="620"
               prefWidth="555"
               wrapText="true"
               style="-fx-text-fill: #ef4565;
                      -fx-font-size: 13px;
                      -fx-font-weight: bold;"/>

        <!-- Botón "Jugar tu avatar" — invisible sobre la imagen -->
        <Button fx:id="siguienteButton"
                onAction="#onSiguienteClicked"
                layoutX="140" layoutY="680"
                prefWidth="555" prefHeight="80"
                opacity="0.01"
                style="-fx-cursor: hand; -fx-background-color: transparent;"/>

    </Pane>

</StackPane>
