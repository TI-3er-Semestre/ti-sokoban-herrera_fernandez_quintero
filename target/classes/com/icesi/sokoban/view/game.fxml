<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<!--
    VISTA — game.fxml

    Indicadores en tiempo real (barra de contadores):
      #playerLabel        jugador activo
      #moveCounterLabel   movimientos
      #pushCounterLabel   empujes
      #timerLabel         cronómetro en tiempo real (actualizado por Timeline)
      #gameCanvas         lienzo del tablero
      #undoButton         deshacer
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.icesi.sokoban.controller.GameController"
      style="-fx-background-color: #0f0e17;"
      spacing="0">

    <!-- Barra superior de estado -->
    <HBox style="-fx-background-color: #16152a; -fx-padding: 8 14 8 14;"
          spacing="20">
        <Label fx:id="statusLabel"
               text="Flechas o WASD para mover · R para reiniciar"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #fffffe;"/>
    </HBox>

    <!-- Barra de indicadores en tiempo real -->
    <HBox style="-fx-background-color: #1a1a2e; -fx-padding: 6 14 6 14;"
          spacing="20" alignment="CENTER_LEFT">
        <Label fx:id="playerLabel"
               text="👤 Invitado"
               style="-fx-font-size: 13px; -fx-text-fill: #3da9fc;"/>
        <Label fx:id="moveCounterLabel"
               text="👣 Mov: 0"
               style="-fx-font-size: 13px; -fx-text-fill: #f2cc8f;"/>
        <Label fx:id="pushCounterLabel"
               text="📦 Emp: 0"
               style="-fx-font-size: 13px; -fx-text-fill: #e07a5f;"/>
        <Label fx:id="timerLabel"
               text="⏱ 0:00"
               style="-fx-font-size: 13px; -fx-text-fill: #3da94f; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="undoButton"
                text="Deshacer"
                onAction="#onUndoClicked"
                style="-fx-font-size: 12px;"/>
    </HBox>

    <!-- Lienzo del juego -->
    <Canvas fx:id="gameCanvas" width="420" height="300"/>

</VBox>
