<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<!--
    VISTA — manual.fxml  (RF5: Mostrar manual del juego)

    Explica las reglas, controles y objetivo del juego.
    Todo el contenido es estático — ManualController solo
    maneja el botón "Volver al Menú".
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.icesi.sokoban.controller.ManualController"
      alignment="CENTER"
      spacing="16"
      style="-fx-background-color: #0f0e17; -fx-padding: 30;">

    <!-- Título -->
    <Label text="📖 Manual del Juego"
           style="-fx-text-fill: #fffffe;
                  -fx-font-size: 32px;
                  -fx-font-weight: bold;"/>

    <ScrollPane fitToWidth="true" prefHeight="480"
                style="-fx-background: #0f0e17;
                       -fx-background-color: #0f0e17;
                       -fx-border-color: #2e2f3e;
                       -fx-border-radius: 6;">

        <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #0f0e17;">

            <!-- Objetivo -->
            <VBox spacing="8" style="-fx-background-color: #16213e;
                                     -fx-padding: 16;
                                     -fx-background-radius: 8;">
                <Label text="🎯 Objetivo"
                       style="-fx-text-fill: #ff8906; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Empuja todas las cajas 📦 hacia las metas 🟣. Cuando todas las cajas estén sobre una meta, ¡ganas el nivel!"
                       wrapText="true"
                       style="-fx-text-fill: #fffffe; -fx-font-size: 14px;"/>
            </VBox>

            <!-- Controles -->
            <VBox spacing="8" style="-fx-background-color: #16213e;
                                     -fx-padding: 16;
                                     -fx-background-radius: 8;">
                <Label text="🎮 Controles"
                       style="-fx-text-fill: #3da9fc; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <VBox spacing="6">
                        <Label text="⬆  W  —  Mover arriba"   style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                        <Label text="⬇  S  —  Mover abajo"    style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                        <Label text="⬅  A  —  Mover izquierda" style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                        <Label text="➡  D  —  Mover derecha"  style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="R  —  Reiniciar nivel"    style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                        <Label text="Deshacer  —  Revertir último movimiento" style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Elementos del tablero -->
            <VBox spacing="8" style="-fx-background-color: #16213e;
                                     -fx-padding: 16;
                                     -fx-background-radius: 8;">
                <Label text="🗺 Elementos del Tablero"
                       style="-fx-text-fill: #3da94f; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="🧍 Jugador  —  Tu personaje. Se mueve en 4 direcciones."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="📦 Caja     —  Empújala hacia las metas. No puedes jalarla."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="🟣 Meta     —  Posición donde debe llegar cada caja."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="⬛ Pared    —  No puedes atravesarla ni empujar cajas a través de ella."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Reglas -->
            <VBox spacing="8" style="-fx-background-color: #16213e;
                                     -fx-padding: 16;
                                     -fx-background-radius: 8;">
                <Label text="📋 Reglas"
                       style="-fx-text-fill: #ef4565; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="• Solo puedes empujar una caja a la vez."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="• No puedes empujar una caja contra una pared u otra caja."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="• Si una caja queda atrapada en una esquina sin salida: Game Over."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="• Cada nivel tiene un tiempo límite. Si se agota: Game Over."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="• Usa Deshacer para corregir un movimiento equivocado."
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
            </VBox>

            <!-- Niveles -->
            <VBox spacing="8" style="-fx-background-color: #16213e;
                                     -fx-padding: 16;
                                     -fx-background-radius: 8;">
                <Label text="🏆 Niveles y Puntaje"
                       style="-fx-text-fill: #f2cc8f; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="⭐ Nivel 1 — First Steps     (BÁSICO)   · Tiempo límite: 5 min"
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="⭐⭐ Nivel 2 — The Labyrinth  (AVANZADO) · Tiempo límite: 10 min"
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="⭐⭐⭐ Nivel 3 — The Algorithm (EXPERTO)  · Sin tiempo límite"
                       style="-fx-text-fill: #fffffe; -fx-font-size: 13px;"/>
                <Label text="El puntaje se calcula con base en movimientos, empujes y tiempo. ¡Menos es mejor!"
                       wrapText="true"
                       style="-fx-text-fill: #a7a9be; -fx-font-size: 12px;"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Botón volver -->
    <Button fx:id="volverButton"
            text="← Volver al Menú"
            onAction="#onVolverClicked"
            style="-fx-background-color: #2a2a4a;
                   -fx-text-fill: #fffffe;
                   -fx-font-size: 15px;
                   -fx-background-radius: 6;
                   -fx-border-color: #555577;
                   -fx-border-radius: 6;
                   -fx-cursor: hand;
                   -fx-padding: 10 28 10 28;"/>

</VBox>

